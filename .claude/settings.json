{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git checkout -b*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git push*)",
      "Bash(git rev-parse*)",
      "Bash(git check-ignore*)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(gh repo view*)",
      "Bash(gh variable *)",
      "Bash(gh api *)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform init*)",
      "Bash(terraform plan*)",
      "Bash(terraform output*)",
      "Bash(terraform providers*)",
      "Bash(terraform show*)",
      "Bash(tflint*)",
      "Bash(checkov*)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(aws * describe-*)",
      "Bash(aws * get-*)",
      "Bash(aws * list-*)",
      "Bash(aws s3 ls*)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl top*)",
      "Bash(helm lint*)",
      "Bash(helm template*)",
      "Bash(helm list*)",
      "Bash(pre-commit *)",
      "Bash(gitleaks *)",
      "Bash(ruff *)",
      "Bash(pytest*)",
      "Bash(uv *)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(ls*)",
      "Bash(tree*)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(* --version)",
      "Bash(* version)"
    ],
    "ask": [
      "Bash(terraform apply*)",
      "Bash(terraform import*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl scale*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(aws * create-*)",
      "Bash(aws * put-*)",
      "Bash(aws * update-*)",
      "Bash(git reset*)",
      "Bash(docker build*)",
      "Bash(docker push*)"
    ],
    "deny": [
      "Bash(terraform destroy*)",
      "Bash(terraform apply -destroy*)",
      "Bash(terraform state rm*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(sudo rm*)",
      "Bash(kubectl delete*)",
      "Bash(helm uninstall*)",
      "Bash(argocd app delete*)",
      "Bash(aws * delete-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws s3 rb*)",
      "Bash(aws s3 rm*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret set*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(./infra/**/terraform.tfvars)",
      "Read(./**/.env)",
      "Read(~/.aws/credentials)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py"
          }
        ]
      }
    ]
  }
}
