# Copy to .env (git-ignored) and fill in the lines marked FILL IN. Everything else is a working
# dev-only default: it exists only inside the containers on your laptop and is never used in AWS.
# Compose reads this via `--env-file .env`; the services read it directly when run locally (Step 6).

COMPOSE_PROJECT_NAME=steakllm

# --- AWS: only Bedrock is real; everything else is a local stand-in --------------------------
AWS_REGION=us-east-1
AWS_PROFILE=                                # FILL IN: profile with Bedrock access (aws configure list-profiles)
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0     # confirmed / changed in 5.6

# --- MinIO stands in for S3 (same API; only the endpoint differs) ----------------------------
MINIO_ROOT_USER=steakllm
MINIO_ROOT_PASSWORD=steakllm-dev-only       # dev-only; MinIO requires >= 8 chars
S3_ENDPOINT_URL=http://localhost:9000
MINIO_CONSOLE_PORT=9001
DOCUMENTS_BUCKET=steakllm-documents
QUARANTINE_PREFIX=quarantine/

# --- DynamoDB Local ---------------------------------------------------------------------------
DYNAMODB_ENDPOINT_URL=http://localhost:8000
CATALOG_TABLE=catalog

# --- Kafka (single node, KRaft) ---------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:9092
TOPIC_DOCUMENTS=documents
TOPIC_DOCUMENTS_RETRY=documents.retry
TOPIC_DOCUMENTS_DLQ=documents.dlq
TOPIC_CHATS=chats

# --- Qdrant (vector store) --------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# --- Embeddings: Ollama, behind the OpenAI-compatible /v1/embeddings contract -----------------
EMBEDDINGS_URL=http://localhost:11434/v1
EMBEDDING_MODEL=all-minilm                  # 384 dimensions; matches the DocumentIndexed example
EMBEDDING_DIM=384

# --- The "vLLM is down" stub: answers 503 so the gateway's fallback path is exercised ---------
VLLM_URL=http://localhost:8081

# --- Open WebUI (chat UI) → the gateway (Step 6) ----------------------------------------------
OPEN_WEBUI_PORT=3000
GATEWAY_URL=http://gateway:8000/v1
GATEWAY_API_KEY=change-me                   # dev-only; the real keys live in Secrets Manager
